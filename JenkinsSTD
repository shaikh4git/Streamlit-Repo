
pipeline {
    agent { label 'DevopsAgentLabelV8' }

    options {
        disableConcurrentBuilds()
        timestamps()
    }
    environment {
        IMAGE_REPO = 'shaikhdocker/sshuda-streamlit-app'
        GITOPS_REPO = 'https://github.com/shaikh4git/Streamlit-GitOps.git'
        GITOPS_BRANCH = 'main'
    }
    
    stages {
        stage('Clean Workspaces!!!') {
            steps { cleanWs() }
                }
 
        stage('Checkout GitHub') {
            steps {
                checkout(
                    changelog: true,
                    poll: true,
                    scm: scmGit(
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'https://github.com/shaikh4git/Streamlit-Repo.git'
                        ]]
                    )
                )

                script {
                    env.IMAGE_TAG =
                        "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
                    env.FULL_IMAGE =
                        "${env.IMAGE_REPO}:${env.IMAGE_TAG}"

                    echo "Changelog sets: ${currentBuild.changeSets.size()}"
                }
            }
        }
         
        stage ('Run only for relevant changes!!!') {
            when {
                anyOf {
                    changeset "app.py"
                    changeset "Dockerfile"
                    changeset "requirements.txt"
                    changeset "JenkinsSTD"
                    changeset "tests/test_app.py"
                    changeset "ansible/**"
                }
            }

            stages {

                stage('Gitleaks Secret Scanning!') {
                    steps {
                        script {
                            sh '''
                                echo "Checking Git repository history..."

                                if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
                                    git fetch --unshallow
                                else
                                    echo "Repository already has full history"
                                fi

                                echo "Starting Gitleaks security scan..."

                                gitleaks git . \
                                    --redact \
                                    --report-format json \
                                    --report-path gitleaks-report.json
                            '''
                        }
                    }

                    post {
                        always {
                        archiveArtifacts artifacts: 'gitleaks-report.json', allowEmptyArchive: true
                        }
                    }
                }

                stage('Install Python Dependencies') {
                    steps {
                        sh '''
                            python3 -m venv .venv
                            .venv/bin/python -m pip install --upgrade pip
                            .venv/bin/python -m pip install -r requirements.txt
                            .venv/bin/python -m pip install pytest
                        '''
                    }
                }

                stage('Streamlit Application Testing') {
                    steps {
                        sh '''
                            echo "Checking Python syntax..."
                            .venv/bin/python -m py_compile app.py

                            echo "Running Streamlit unit tests..."
                            .venv/bin/python -m pytest tests/ -v

                            echo "Streamlit application testing completed."
                        '''
                    }
                }                

                stage("Sonarqube Analysis "){
                    steps{
                        withSonarQubeEnv('sonar-server') {
                            sh ''' /opt/sonar-scanner/bin/sonar-scanner -Dsonar.projectName=Streamlit \
                            -Dsonar.projectKey=Streamlit '''
                        }
                    }
                }
                stage("Quality Gate Checkpoint"){
                    steps {
                        script {
                            waitForQualityGate abortPipeline: false, credentialsId: 'Sonar-token' 
                        }
                    } 
                } 

               /*
                stage('OWASP FS SCAN') {
                    steps {
                        dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit', odcInstallation: 'DP-Check'*/
                  //      dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
              /*      }
                }
                */
                /* stage('TRIVY FS SCAN') {
                    steps {
                        sh "/home/jenkins/bin/trivy fs . "
                        sh "/home/jenkins/bin/trivy fs . > trivyfs.txt"
                    }
                } */

                stage('Docker Build & Push Streamlit image - DockerHub artifacts Registry') {
                    steps {
                        withCredentials([
                            string(
                                credentialsId: 'docker_cred',
                                variable: 'DOCKER_API_KEY'
                            )
                        ]) {
                            sh '''
                                set +x

                                echo "$DOCKER_API_KEY" |
                                docker login -u shaikhdocker --password-stdin

                                docker buildx build \
                                --tag "$FULL_IMAGE" \
                                --load \
                                .

                               # docker push "$FULL_IMAGE"
                            '''
                        }
                    }
                }

                /* stage("TRIVY"){
                    steps{
                        sh "/home/jenkins/bin/trivy image $FULL_IMAGE > trivyimage.txt" 
                    }
                } */


                stage('Deploy to Docker Desktop Staging - Ansible') {
                    steps {
                        sh '''
                            ansible-playbook \
                            -i localhost, \
                            ansible/staging.yaml \
                            -e "image_repo=$IMAGE_REPO" \
                            -e "image_tag=$IMAGE_TAG"
                        '''
                    }
                }

                stage('Validate Streamlit Staging') {
                    steps {
                        sh '''
                            curl --fail \
                            --retry 10 \
                            --retry-delay 3 \
                            --retry-connrefused \
                            http://host.docker.internal:8502/_stcore/health
                        '''
                    }
                }

              /*  stage('Deploy to Docker - Staging!!') {
                    steps {
                        sh '''
                            docker pull "$FULL_IMAGE"

                            if docker ps -aq \
                            --filter "name=^streamlit$" | grep -q .; then
                                docker rm -f streamlit
                            fi

                            docker run -d \
                            --name streamlit \
                            -p 8501:8501 \
                            "$FULL_IMAGE"
                        '''
                    }
                } */


                stage('Approve Production Deployment') {
                    steps {
                        input message: 'Deploy Streamlit to Kubernetes?',
                            ok: 'Approve Deployment'
                    }
                }



                stage('Update GitOps Repository') {
                    steps {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'github-gitops-token',
                                usernameVariable: 'GIT_USERNAME',
                                passwordVariable: 'GIT_TOKEN'
                            )
                        ]) {
                            sh '''
                                set -eu
                                set +x

                                export GIT_TERMINAL_PROMPT=0
                                HELPER='!f() { echo "username=$GIT_USERNAME"; echo "password=$GIT_TOKEN"; }; f'

                                git -c credential.helper="$HELPER" clone \
                                --branch "$GITOPS_BRANCH" "$GITOPS_REPO" gitops
                                cd gitops

                                test -f argocd/strmlit-deployment.yaml

                                sed -i -E "s#(image:[[:space:]]*)shaikhdocker/sshuda-streamlit-app:[^[:space:]]+#\\1${FULL_IMAGE}#" \
                                argocd/strmlit-deployment.yaml

                                grep -q "image: ${FULL_IMAGE}" argocd/strmlit-deployment.yaml \
                                || { echo "Image line was not updated"; exit 1; }

                                git config user.name "Jenkins CI"
                                git config user.email "jenkins@localhost"
                                git add argocd/strmlit-deployment.yaml

                                if git diff --cached --quiet; then
                                    echo "No GitOps changes required"
                                else
                                    git commit -m "Deploy Streamlit ${FULL_IMAGE}"
                                    git -c credential.helper="$HELPER" pull --rebase origin "$GITOPS_BRANCH"
                                    git -c credential.helper="$HELPER" push origin "HEAD:${GITOPS_BRANCH}"
                                fi
                            '''
                        }
                    }
                }

                stage('GitOps Commit Published') {
                    steps {
                        echo """
                        Jenkins pushed the approved image tag to Git.

                        Image: ${env.FULL_IMAGE}
                        Repository: ${env.GITOPS_REPO}

                        Argo CD will reconcile the Streamlit application!
                        """
                    }
                }
            }
        }    
    }

    post {
        always {
            emailext(
                    attachLog: true,
                    subject: "${currentBuild.currentResult}",
                    body: """
                        Project: ${env.JOB_NAME}<br/>
                        Build: ${env.BUILD_NUMBER}<br/>
                        Image: ${env.FULL_IMAGE ?: 'Not built'}<br/>
                        URL: ${env.BUILD_URL}<br/>
                    """,
                    to: 'shaikh4huda@gmail.com',
                    attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
                    )
                }
    }        
       
        
}